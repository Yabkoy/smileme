{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "emoji-picker",
  "version": "0.1.0",
  "identifier": "com.yabkoy.emoji-picker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
"app": {
  "windows": [
    {
      "label": "main",
      "title": "Emoji Picker",
      "width": 420,
      "height": 480,
      "center": true,
      "visible": false,
      "decorations": false,
      "alwaysOnTop": true,
      "skipTaskbar": true,
      "resizable": false,
      "shadow": true,
      "backgroundColor": "#171717"
    }
  ],
  "security": {
    "csp": null
  }
},
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
